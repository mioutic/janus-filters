      "sha256": "204ab95a131deffe50f48f977948c7e237e0a270d32c211ed7cd3c763ee545c7",
      "mime": "text/javascript",
      "patterns": [
        "^https?://imasdk\\.googleapis\\.com/js/sdkloader/ima3\\.js",
        "^https?://s0\\.2mdn\\.net/instream/html5/ima3\\.js"
      ],
      "resourceTypes": ["script"],
      "globals": ["google"],
      "notes": "IMA SDK. The surrogate defines google.ima with stub AdsLoader/AdsManager so the player reports 'no ad' instead of hanging."
    },
    {
      "id": "googletagservices-gpt",
