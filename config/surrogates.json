      "resourceTypes": ["script"],
      "globals": ["pbjs"],
      "notes": "Prebid.js is self-hosted, so the pattern is path-based like uBO's /prebid*.js. Deliberately unanchored; the fallback block covers what the redirect misses."
    },
    {
      "id": "noopvast-4.0",
      "file": "noopvast04.xml",
      "sha256": "9f487a052b25ce116e8f5d8e3f3b1bb0ed5b6b5232462c3b279c18cfd324b027",
