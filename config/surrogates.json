        "^https?://c\\.amazon-adsystem\\.com/aax2/apstag\\.js"
      ],
      "resourceTypes": ["script"],
      "globals": ["apstag"],
      "notes": "Amazon TAM header bidding. fetchBids calls back with an empty array, so the page's auction finishes."
    },
    {
      "id": "prebid",
      "file": "prebid.js",
      "sha256": "c02d04af9ae0e41059ec9a9773a124618df592379ef2dd63a9532bc3eeadc0a1",
