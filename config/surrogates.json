{
  "schemaVersion": 1,
  "note": "PIPELINE 11.2 and DESIGN 3.6. Order is normative: the pack stage emits every redirect rule in this order, then every fallback block rule in the same order, with no ignore-previous-rules between the two sections. resourceTypes never contains document, top-document, child-document or image. Patterns are WebKit url-filter regexes: no non-capturing groups, no {n,m} quantifiers, no lookaround - only what WKContentRuleListStore accepts.",
  "redirectSource": {
    "package": "@adguard/scriptlets",
    "version": "2.5.1",
    "dir": "dist/redirect-files"
  },
  "surrogates": [
    {
