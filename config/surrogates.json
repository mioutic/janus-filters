        "^https?://www\\.googletagservices\\.com/tag/js/gpt\\.js"
      ],
      "resourceTypes": ["script"],
      "globals": ["googletag"],
      "notes": "Google Publisher Tag. Without the surrogate, pages that queue googletag.cmd callbacks never render their content."
