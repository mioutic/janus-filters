      ],
      "resourceTypes": ["script"],
      "globals": ["adsbygoogle"],
      "notes": "AdSense loader. The surrogate keeps the adsbygoogle push queue alive and collapses the slots."
    },
    {
      "id": "amazon-apstag",
      "file": "amazon-apstag.js",
      "sha256": "6d4bcf2a273911439dcf3bb247b7acd71d02f1d3ca8b1bedc59ad3b1960bc97b",
